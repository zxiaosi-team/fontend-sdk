{
  "name": "frontend-sdk",
  "private": true,
  "scripts": {
    "build:all": "pnpm -r run build",
    "build:sdk": "pnpm -F sdk run build",
    "changelog:sdk": "npx git-cliff --workdir sdk -o CHANGELOG.md",
    "clean": "pnpm -r exec rimraf node_modules && npx rimraf node_modules",
    "clean:cache": "pnpm -r exec rimraf node_modules/.vite",
    "dev:main": "pnpm -F main run dev",
    "dev:sdk": "pnpm -F sdk run dev",
    "dev:subapp1": "pnpm -F subapp1 run dev",
    "dev:subapp2": "pnpm -F subapp2 run dev",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky && echo npx lint-staged > .husky/pre-commit",
    "publish:sdk": "pnpm -F sdk run publish"
  },
  "devDependencies": {
    "git-cliff": "^2.13.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": "oxlint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.2.2"
}
