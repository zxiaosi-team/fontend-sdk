{
  "name": "frontend-sdk",
  "private": true,
  "scripts": {
    "build:all": "pnpm -r run build",
    "build:sdk": "pnpm -F sdk run build",
    "clean": "pnpm -r exec rimraf node_modules && npx rimraf node_modules",
    "dev:main": "pnpm -F main run dev",
    "dev:sdk": "pnpm -F sdk run dev",
    "dev:subapp1": "pnpm -F subapp1 run dev",
    "dev:subapp2": "pnpm -F subapp2 run dev",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky && echo npx lint-staged > .husky/pre-commit",
    "publish:sdk": "pnpm -F sdk run publish"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": "oxlint --fix",
    "**/*.{js,jsx,ts,tsx,less}": "prettier --write"
  },
  "dependencies": {},
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxlint": "^1.33.0",
    "prettier": "^3.7.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^2.5.20"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  }
}
